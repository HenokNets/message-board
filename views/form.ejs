<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <header>
    <h1><%= title %></h1>
    <p>Share a message with everyone.</p>
  </header>

  <main>
    <form method="POST" action="/new">

      <div class="form-group">
        <label for="messageUser">Your name</label>
        <input
          type="text"
          id="messageUser"
          name="messageUser"
          placeholder="Enter your name"
          required
        >
      </div>

      <div class="form-group">
        <label for="messageText">Your message</label>
        <textarea
          id="messageText"
          name="messageText"
          placeholder="Write your message..."
          required
        ></textarea>
      </div>

      <button type="submit">Send Message</button>

    </form>

    <a href="/">Back to messages</a>
  </main>

</body>
</html>