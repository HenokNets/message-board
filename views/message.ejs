<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header>
    <h1><%= title %></h1>
    <p>Message details</p>
  </header>

  <main>

    <article class="message-card detail-card">

      <h2><%= message.user %></h2>

      <p><%= message.text %></p>

      <small>
        Posted: <%= message.added.toLocaleString() %>
      </small>

    </article>

    <a href="/" class="new-message-btn">
      Back to messages
    </a>

  </main>

</body>
</html>